#!/bin/sh
# Update Speedy to the latest release (serve/update.py): --check, --yes, --rollback. Nothing runs by itself.
cd "$(dirname "$0")" || exit 1
for py in .venv/bin/python python/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1 || [ -x "$py" ]; then exec "$py" serve/update.py "$@"; fi
done
echo "No Python found: run serve/update.py with Python 3.10+."; exit 1
