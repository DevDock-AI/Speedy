{
  "exe": "<SPEEDY_DIR>/build/strata",
  "args": [
    "--pack",
    "<MODELS_DIR>/packs/iq3_s",
    "dir>",
    "--native",
    "<MODELS_DIR>/models/q38-ista-iq3s/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "dir>/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--expert-profile",
    "<SPEEDY_DIR>/data/expert-profile.bin",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "<STRATA_DATA>/mtp/rt",
    "dir>",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--ple-io",
    "direct",
    "--stats",
    "--expert-cache",
    "auto",
    "--ple-row-cache",
    "1048576",
    "--conversation-cache-mib",
    "8192",
    "--conversation-cache-slots",
    "8",
    "--mtp-draft-vocab",
    "<SPEEDY_DIR>/data/draft_vocab_zh60k.bin",
    "--kv-resident",
