    "STRATA_PEER_TRANSPORT": "host",
    "STRATA_HIP_WMMA": "1",
    "STRATA_SELECT_WMMA": "1",
    "STRATA_SH_STREAM": "0",
    "STRATA_PREFILL_AUTO_MAX": "32768",
    "STRATA_PREFILL_MMQ_TILE_ROWS": "32",
    "STRATA_GR_RDNA": "1",
    "STRATA_GR_RDNA_Q8": "1",
    "STRATA_RDNA_Q6K": "1",
    "STRATA_GR_RDNA_A8": "1",
    "STRATA_QFUSE": "1",
    "STRATA_COMBINE_CPU": "1",
    "STRATA_VERIFY_QDEDUP": "1",
    "STRATA_WAIT_FUSE": "1",
    "STRATA_ROUTE_PUBLISH": "1",
    "STRATA_GR_INJ_UP": "1",
    "STRATA_PF_FUSED": "1",
    "STRATA_STAGER_RING": "64",
    "STRATA_PREFILL_CPU_SHARE": "0.6",
    "STRATA_PREFILL_CPU_SHARE_MAX": "4096",
    "GPU_MAX_HW_QUEUES": "6",
    "STRATA_GR_FUSED": "1",
    "STRATA_GDN_HEAD": "1",
    "STRATA_GDN_CHUNKED": "1",
    "STRATA_GDN_CHUNK_GDV": "0",
    "STRATA_PA_KLDS": "1",
    "STRATA_GDN_PP": "1",
    "STRATA_GDN_CONVL2": "1",
    "STRATA_GDN_NOY": "1",
    "STRATA_PF_GEMM": "1",
    "STRATA_PF_PAD": "1",
    "STRATA_HC_UPMIX": "1",
    "STRATA_PF_HCDOWN": "1",
    "STRATA_FUSE_CONVAB": "1",
    "STRATA_HEAD_MIX_MULTI": "1",
    "STRATA_PA_FAST": "1",
    "STRATA_PF_GROUP_RES": "1",
    "STRATA_PF_F16": "2",
    "STRATA_PREFILL_RING": "192",
    "STRATA_KV_HOST_DMA": "1",
    "STRATA_ADAPT_OVERLAP": "1",
    "STRATA_TOPK_SPLIT_MIN": "98304",
    "STRATA_QSA_ROWS": "1"
