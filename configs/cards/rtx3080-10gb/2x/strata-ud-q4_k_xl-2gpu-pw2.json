{
  "exe": "<SPEEDY_DIR>/build/strata",
  "args": [
    "--pack",
    "<MODELS_DIR>/packs/unsloth-ud-q4_k_xl",
    "--native",
    "<MODELS_DIR>/models/q38-ud-q4kxl/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
    "--expert-profile",
    "<SPEEDY_DIR>/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--mtp",
    "<STRATA_DATA>/mtp/rt",
    "--max-context",
    "229376",
    "--kv",
    "int8",
    "--kv-resident",
    "20480",
    "--vram-reserve-mib",
    "700",
    "--conversation-cache-mib",
    "8192",
    "--adapt-async",
    "1",
    "--adapt-swaps",
    "80",
    "--pool-affinity",
    "measure",
    "--resident-budget-gib",
    "80",
    "--layer-split",
    "26",
    "--trim-stage-weights",
    "--vram-reserve-later-mib",
    "500",
    "--pipeline-windows",
    "2"
  ],
  "cwd": "<SPEEDY_DIR>",
  "tokenizer": "<MODELS_DIR>/packs/unsloth-ud-q4_k_xl/tokenizer",
  "model_name": "qwen3.8-flash-next-ud-q4_k_xl",
  "log": "<LOG_DIR>/strata-ud-q4_k_xl-2gpu-pw2.log",
  "lib_dirs": [
    "/usr/local/cuda/lib64"
  ],
  "port": 8080,
  "gpu": 0,
  "gpus_asked": true,
  "draft_vocab": "en",
  "sampling": {
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 1.5
  },
  "reasoning_effort": "medium",
  "env": {
    "STRATA_ROUTE_TAIL_SKIP": "0",
    "STRATA_PREFILL_CPU_SHARE": "0",
    "STRATA_PIN_BY_NEED": "1",
    "STRATA_EXPDEC": "1",
    "STRATA_EXCHANGE_ROTATE": "1",
    "STRATA_ATTN_DAILY": "1",
    "STRATA_VERIFY_DEFER_CPU": "1",
    "STRATA_VERIFY_DEFER_CPU_BELOW": "0.1",
    "STRATA_HC_Q8": "1",
    "STRATA_PROMPT_ATTN_IMMA": "1",
    "STRATA_KV_PREFETCH": "1",
    "STRATA_PF_GROUP_SCRATCH": "1",
    "STRATA_PF_HC_REGION": "1",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "CUDA_VISIBLE_DEVICES": "<GPU1_UUID>,<GPU2_UUID>",
    "STRATA_PREFILL_HELP": "1",
    "STRATA_PIPELINE_PENALTIES": "1"
  },
  "reasoning_budget_tokens": 16384,
  "reasoning_close_retry": true,
  "repeat_stop_tokens": 256,
  "host": "127.0.0.1",
  "fit_max_tokens": true,
  "serve_dir": "<SPEEDY_DIR>"
}